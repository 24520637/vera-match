{
  "name": "vera-match",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace apps/api",
    "prisma:validate": "npm run prisma:validate --workspace apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "test:ops": "node scripts/verify-synthetic-backup.cjs",
    "staff:provision": "node scripts/staff-provision.cjs",
    "test:staff-mfa": "node scripts/run-staff-mfa-e2e.cjs",
    "staff:mfa-rewrap": "node scripts/staff-mfa-rewrap.cjs",
    "consent:policy-candidate": "node scripts/consent-policy-candidate.cjs",
    "release:preflight": "node scripts/release-preflight.cjs",
    "test:release-config": "node --test scripts/release-preflight.spec.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "body-parser@1": "1.20.9",
    "multer@2": "2.5.0",
    "lodash@4": "4.18.1",
    "js-yaml@4": "4.3.2",
    "postcss@8": "8.5.23",
    "qs@6": "6.16.1",
    "picomatch@4": "4.0.4",
    "ajv@8": "8.18.0",
    "webpack@5": "5.104.1",
    "glob@10": "10.5.0",
    "inquirer@8": "8.2.7",
    "inquirer@9": "9.3.8",
    "@prisma/config@6.19.3": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.1"
    }
  }
}
