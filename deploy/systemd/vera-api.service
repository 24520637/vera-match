[Unit]
Description=VERA Match API (single process)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vera
Group=vera
WorkingDirectory=/srv/vera-match
Environment=NODE_ENV=production
EnvironmentFile=/etc/vera-match/api.env
ExecStart=/usr/bin/node /srv/vera-match/apps/api/dist/main.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
