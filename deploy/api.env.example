# Host-only /etc/vera-match/api.env. Replace every REPLACE_* value.
# Shell-compatible quoting also supports loading this file for build/preflight.
NODE_ENV=production
API_PORT=4000
DATABASE_URL='postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5433/vera_match?schema=public'
APP_BASE_URL=https://REPLACE_DOMAIN
CORS_ORIGIN=https://REPLACE_DOMAIN
SESSION_COOKIE_NAME=__Host-vera_session
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_FROM='VERA Match <noreply@REPLACE_DOMAIN>'
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
MINIO_ENDPOINT=https://REPLACE_PRIVATE_STORAGE_HOST
MINIO_ROOT_USER=REPLACE_SCOPED_STORAGE_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_SCOPED_STORAGE_SECRET_KEY
MINIO_BUCKET=vera-private
VIDEO_DURATION_FFPROBE=/usr/bin/ffprobe
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MATCHING_HANDLE_KEY=REPLACE_64_HEX_CHARACTERS
# Production documentation stays disabled unless public read-only docs are wanted.
# The existing public-demo preflight/smoke requires public explicitly.
API_DOCS_MODE=public
RECOVERY_MODE=normal
RECOVERY_JOURNAL_CLIENT_CONFIG=/etc/vera-match/recovery/client.json
# Exact approval is required before real production closure can be accepted.
# CLOSURE_POLICY_MANIFEST_PATH=/etc/vera-match/closure/approved.json
# CLOSURE_POLICY_APPROVAL_PUBLIC_KEY_PATH=/etc/vera-match/closure/authority.pub
# Real-user access requires independently approved operator-installed files.
# STAFF_AUTHORITY_KEYS_PATH=/etc/vera-match/staff/authority-public-keys.json
# STAFF_MFA_KEYRING_PATH=/etc/vera-match/staff/mfa-wrapping-keys.json
# CONSENT_POLICY_MANIFEST_PATH=/etc/vera-match/consent/approved.json
# CONSENT_POLICY_APPROVAL_PUBLIC_KEY_PATH=/etc/vera-match/consent/authority.pub
# EXPERT_QUALIFICATION_MANIFEST_PATH=/etc/vera-match/experts/approved.json
# EXPERT_QUALIFICATION_PUBLIC_KEY_PATH=/etc/vera-match/experts/authority.pub
