// VERA Match — Prisma data model draft. Requires `prisma validate` and migration test.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  EXPERT
  MODERATOR
  ADMIN
}
enum AccountStatus {
  PENDING_EMAIL
  ACTIVE
  SUSPENDED
  DELETED
}
enum ConsentPurpose {
  PROFILE_MATCHING
  VIDEO_STORAGE
  EXPERT_VIDEO_REVIEW
  REPORT_SHARING
  VIDEO_CLAIM_MATCHING
}
// Editing revisions are independent of questionnaire catalog versions and consent.
enum MemberResource {
  PROFILE
  PREFERENCES
  QUESTIONNAIRE
}
enum VideoStatus {
  UPLOADING
  READY
  UNDER_REVIEW
  DELETED
}
enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  CANCELLED
  COMPLETED
}
enum ReviewStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  WITHDRAWN
}
enum ObservationCategory {
  EYE
  FACIAL
  BODY
  SPEECH
  CROSS_MODAL
}
enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}
enum MatchChoice {
  ACCEPT
  DECLINE
}
enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  displayName String?
  role UserRole @default(MEMBER)
  status AccountStatus @default(PENDING_EMAIL)
  declaredAdult Boolean @default(false)
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  emailTokens EmailVerificationToken[]
  resetTokens PasswordResetToken[]
  profile Profile?
  preferences MatchPreference?
  questionnaireAnswers QuestionnaireAnswer[]
  resourceRevisions MemberResourceRevision[]
  consents Consent[]
  consentLedger ConsentLedger?
  blocksMade Block[] @relation("Blocker")
  blocksReceived Block[] @relation("Blocked")
  reportsMade Report[] @relation("Reporter")
  reportsReceived Report[] @relation("ReportTarget")
  reportsModerated Report[] @relation("ReportModerator")
  videos Video[]
  expertAssignments ExpertAssignment[] @relation("AssignedExpert")
  createdAssignments ExpertAssignment[] @relation("AssignmentCreator")
  expertCredential ExpertCredential?
  expertActorIdentity ExpertActorIdentity?
  @@index([status, role])
}

model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastSeenAt DateTime?
  @@index([userId, expiresAt])
}
model EmailVerificationToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model Profile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate DateTime?
  occupation String?
  city String?
  bio String? @db.Text
  relationshipGoal String?
  interests Json?
  values Json?
  visibilityEnabled Boolean @default(false)
  updatedAt DateTime @updatedAt
}
// No FK to the optional data row: clearing data must not reset its revision.
// Missing metadata projects virtual revision 0; reads must never create rows.
model MemberResourceRevision {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource MemberResource
  // SQL enforces 0 <= revision <= Number.MAX_SAFE_INTEGER. Map explicitly at the API boundary.
  revision BigInt @default(0)
  @@id([userId, resource])
}
model MatchPreference {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  minAge Int?
  maxAge Int?
  relationshipGoal String?
  dealBreakers Json?
  priorities Json?
  updatedAt DateTime @updatedAt
}
model QuestionnaireAnswer {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionKey String
  questionnaireVersion Int @default(1)
  responseText String @db.Text
  updatedAt DateTime @updatedAt
  @@unique([userId, questionKey, questionnaireVersion])
  @@index([userId, questionnaireVersion])
}
model Consent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose ConsentPurpose
  granted Boolean @default(false)
  grantedAt DateTime?
  revokedAt DateTime?
  policyVersion String?
  policyEvidenceId String? @db.Uuid
  policyEvidence ConsentPolicyEvidence? @relation(fields: [policyEvidenceId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt
  @@unique([userId, purpose])
}
// Live identity mapping is deleted with User. Opaque subjects/evidence are not.
model ConsentSubject {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ledger ConsentLedger?
  events ConsentEvent[]
  idempotency ConsentIdempotency[]
  tasks ConsentWithdrawalTask[]
  assignments ExpertAssignment[]
}
model ConsentLedger {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String @unique @db.Uuid
  subject ConsentSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  version BigInt @default(0)
}
model ConsentPolicyEvidence {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose ConsentPurpose
  policyVersion String
  locale String
  content String @db.Text
  digest String
  testOnly Boolean @default(false)
  algorithm String @default("SHA-256")
  encoding String @default("UTF-8")
  createdAt DateTime @default(now())
  states Consent[]
  events ConsentEvent[]
  @@unique([purpose, policyVersion, locale])
}
enum ConsentEventKind {
  STATE_CHANGED
  OFF_REAFFIRMED
  GRANT_REAFFIRMED
  POLICY_RECONSENT
}
model ConsentEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId String @db.Uuid
  subject ConsentSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  // /me actor is the same opaque subject; no live user ID or session token.
  purpose ConsentPurpose
  oldGranted Boolean
  newGranted Boolean
  kind ConsentEventKind
  previousVersion BigInt
  nextVersion BigInt
  policyVersion String?
  policyEvidenceId String? @db.Uuid
  policyEvidence ConsentPolicyEvidence? @relation(fields: [policyEvidenceId], references: [id], onDelete: Restrict)
  evidenceGap Boolean @default(false)
  createdAt DateTime @default(now())
  withdrawalTask ConsentWithdrawalTask?
  @@unique([subjectId, nextVersion, purpose])
}
model ConsentIdempotency {
  subjectId String @db.Uuid
  subject ConsentSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  keyHash String
  fingerprint String
  response Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@id([subjectId, keyHash])
  @@index([expiresAt])
}
model ConsentWithdrawalTask {
  assignmentReceipt AssignmentWithdrawalReceipt?
  assignmentCancellations AssignmentCancellationContext[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId String @db.Uuid
  subject ConsentSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  eventId String @unique @db.Uuid
  event ConsentEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  purpose ConsentPurpose
  version BigInt
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastErrorCode String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt])
}
model Video {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bucket String
  objectKey String @unique
  uploadKey String? @unique
  uploadExpiresAt DateTime?
  cleanupCompletedAt DateTime?
  storageConsentVersion BigInt?
  mimeType String
  sizeBytes Int?
  durationMs Int?
  status VideoStatus @default(UPLOADING)
  createdAt DateTime @default(now())
  deletedAt DateTime?
  assignments ExpertAssignment[]
  @@index([ownerId, status])
}
// Durable storage locators survive account/metadata deletion. Never expose to clients.
model VideoWithdrawalReceipt {
  withdrawalTaskId String @id @db.Uuid
  processedAt DateTime @default(now())
}
model VideoCleanupTask {
  id String @id @default(cuid())
  videoId String @unique
  bucket String
  objectKey String
  uploadKey String?
  uploadExpiresAt DateTime?
  removeFinal Boolean @default(true)
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastErrorCode String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
}
model ExpertAssignment {
  id String @id @default(cuid())
  videoId String
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  expertId String
  expert User @relation("AssignedExpert", fields: [expertId], references: [id])
  assignedById String?
  assignedBy User? @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)
  // Nullable only for pre-C031 rows; SQL requires evidence/binding for new assignments.
  assignedByEvidence Json?
  credentialApprovalId String? @db.Uuid
  credentialApproval ExpertCredentialApproval? @relation(fields: [credentialApprovalId], references: [id], onDelete: Restrict)
  // Nullable for legacy rows only; C033 records the authoritative review generation.
  reviewConsentSubjectId String? @db.Uuid
  reviewConsentSubject ConsentSubject? @relation(fields: [reviewConsentSubjectId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ExpertAssignment_review_subject_fkey")
  reviewConsentVersion BigInt?
  revision BigInt @default(0)
  // Internal mutation witness; not part of future API DTOs or retained snapshots.
  eventFromStatus AssignmentStatus?
  eventTransactionId String?
  status AssignmentStatus @default(ASSIGNED)
  dueAt DateTime?
  expiresAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  review ExpertReview?
  // SQL migration enforces one active primary assignment per video with a partial unique index.
  @@index([expertId, status])
  @@index([videoId, status])
  @@index([assignedById])
  @@index([credentialApprovalId])
}

// Opaque actor scope and original result survive live account/assignment deletion.
model AssignmentIdempotency {
  actorSubjectId String @db.Uuid
  operation String
  keyHash String
  fingerprint String
  assignmentId String
  identity ExpertAssignmentIdentity @relation(fields: [assignmentId], references: [assignmentId], onDelete: Restrict, onUpdate: NoAction, map: "AssignmentIdempotency_identity_fkey")
  response Json
  createdAt DateTime @default(now())
  @@id([actorSubjectId, operation, keyHash])
  @@index([assignmentId])
}

enum ExpertCredentialStatus {
  PENDING
  APPROVED
  REVOKED
}

// Issued assignment IDs survive deletion of live resources; no cascading foreign key.
model ExpertAssignmentIdentity {
  assignmentId String @id
  receipts AssignmentIdempotency[]
}

// Live identity mapping only; retained evidence carries the opaque subject.
model ExpertActorIdentity {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
}

enum ExpertCredentialEventKind {
  CREATED
  TRAINING_RECORDED
  CONFIDENTIALITY_RECORDED
  VERIFIED
  APPROVED
  REVOKED
}

// Live identity mapping only. Retained evidence never cascades through this row.
model ExpertCredential {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status ExpertCredentialStatus @default(PENDING)
  revision BigInt @default(0)
  approvalId String? @db.Uuid
  approval ExpertCredentialApproval? @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  revokedAt DateTime?
}

// Approval is a new immutable instance each time, never a reusable eligibility flag.
model ExpertCredentialApproval {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId String @db.Uuid
  trainingVersion String
  policyVersion String
  trainingEvidence Json
  confidentialityEvidence Json
  verifiedByEvidence Json
  verifiedAt DateTime
  approvedByEvidence Json
  approvedAt DateTime @default(now())
  expiresAt DateTime?
  credentials ExpertCredential[]
  assignments ExpertAssignment[]
  credentialEvents ExpertCredentialEvent[]
  assignmentEvents AssignmentEvent[]
  @@index([subjectId, approvedAt])
}

// No User/current-credential FK: deletion cannot erase independently retained evidence.
model ExpertCredentialEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId String @db.Uuid
  revision BigInt
  kind ExpertCredentialEventKind
  status ExpertCredentialStatus
  approvalId String? @db.Uuid
  approval ExpertCredentialApproval? @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  actorEvidence Json
  evidence Json
  trainingVersion String?
  policyVersion String?
  verifiedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  reason String?
  // SQL BEFORE INSERT always replaces caller input with database UTC recording time.
  createdAt DateTime @default(now())
  @@unique([subjectId, revision])
}

// assignmentId is an opaque historical locator, deliberately not a cascading FK.
model AssignmentEvent {
  cancellation AssignmentCancellationContext?
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String
  revision BigInt
  fromStatus AssignmentStatus?
  toStatus AssignmentStatus
  credentialApprovalId String? @db.Uuid
  credentialApproval ExpertCredentialApproval? @relation(fields: [credentialApprovalId], references: [id], onDelete: Restrict)
  actorEvidence Json
  snapshot Json
  // SQL BEFORE INSERT always replaces caller input with database UTC recording time.
  createdAt DateTime @default(now())
  @@unique([assignmentId, revision])
}
model ExpertReview {
  id String @id @default(cuid())
  assignmentId String @unique
  assignment ExpertAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status ReviewStatus @default(DRAFT)
  summary String? @db.Text
  limitations String? @db.Text
  version Int @default(1)
  submittedAt DateTime?
  qaById String?
  qaAt DateTime?
  qaFeedback String? @db.Text
  observations ExpertObservation[]
  claims ReviewClaim[]
  disputes ReviewDispute[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ExpertObservation {
  id String @id @default(cuid())
  reviewId String
  review ExpertReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  category ObservationCategory
  startMs Int
  endMs Int
  observation String @db.Text
  context String? @db.Text
  createdAt DateTime @default(now())
  @@index([reviewId, category])
}
model ReviewClaim {
  id String @id @default(cuid())
  reviewId String
  review ExpertReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  // Only owner-confirmed, QA-approved, factual semantic claims may be matchable.
  claimType String
  claimText String @db.Text
  qaApproved Boolean @default(false)
  ownerConfirmed Boolean @default(false)
  shareApproved Boolean @default(false)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([reviewId, qaApproved, ownerConfirmed, shareApproved])
}
model ReviewDispute {
  id String @id @default(cuid())
  reviewId String
  review ExpertReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  ownerId String
  reason String @db.Text
  status DisputeStatus @default(OPEN)
  resolution String? @db.Text
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  @@index([ownerId, status])
}
model MatchPair {
  id String @id @default(cuid())
  userLowId String
  userHighId String
  // Store sorted user ids to prevent (A,B) vs (B,A) duplicate pairs.
  score Float?
  reasons Json?
  createdAt DateTime @default(now())
  decisions MatchDecision[]
  @@unique([userLowId, userHighId])
}
model MatchDecision {
  id String @id @default(cuid())
  pairId String
  pair MatchPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  actorUserId String
  choice MatchChoice
  createdAt DateTime @default(now())
  @@unique([pairId, actorUserId])
}
model Block {
  id String @id @default(cuid())
  blockerId String
  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
model Report {
  id String @id @default(cuid())
  reporterId String?
  reporter User? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUserId String?
  target User? @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  reason String @db.Text
  reasonCode ReportReason?
  revision BigInt @default(0)
  status ReportStatus @default(OPEN)
  moderatorId String?
  moderator User? @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  actions ReportModerationAction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetUserId])
  @@index([moderatorId])
}
enum ReportReason {
  HARASSMENT
  INAPPROPRIATE_CONTENT
  IMPERSONATION
  SPAM
  OTHER
}
model ReportModerationAction {
  id String @id @default(cuid())
  reportId String
  report Report @relation(fields: [reportId], references: [id], onDelete: Restrict)
  revision BigInt
  fromStatus ReportStatus
  toStatus ReportStatus
  actorEvidence Json
  createdAt DateTime @default(now())
  @@unique([reportId, revision])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  subjectType String
  subjectId String?
  createdAt DateTime @default(now())
  // No raw video bytes, tokens, password, or sensitive review text in audit.
  @@index([actorId, createdAt])
}

// C051 evidence survives live assignment/video/account removal via retained events.
enum AssignmentCancellationReason {
  VIDEO_DELETED
  VIDEO_STORAGE_WITHDRAWN
  EXPERT_VIDEO_REVIEW_WITHDRAWN
}
model AssignmentCancellationContext {
  eventId String @id @db.Uuid
  event AssignmentEvent @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reason AssignmentCancellationReason
  sourceTaskId String? @db.Uuid
  sourceTask ConsentWithdrawalTask? @relation(fields: [sourceTaskId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  initiatorEvidence Json
  createdAt DateTime @default(now())
  @@index([sourceTaskId])
}
model AssignmentWithdrawalReceipt {
  withdrawalTaskId String @id @db.Uuid
  withdrawalTask ConsentWithdrawalTask @relation(fields: [withdrawalTaskId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now())
}

// Mutable scheduling metadata only; never a completion receipt or authorization grant.
model AssignmentCancellationScan {
  lane String @id
  afterId String?
  throughId String?
}
