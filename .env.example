# LOCAL DEVELOPMENT ONLY. Never commit real credentials.
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5433/vera_match?schema=public
POSTGRES_USER=vera_dev
POSTGRES_PASSWORD=
POSTGRES_DB=vera_match
# Cookie config: local same-site dev uses lax; production requires HTTPS and secure cookies.
SESSION_COOKIE_NAME=vera_session
SESSION_TTL_SECONDS=604800
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# SMTP dev catcher (Mailpit): http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=VERA Match <noreply@localhost.test>
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# Leave authentication empty for a native local SMTP catcher only.
SMTP_USER=
SMTP_PASSWORD=
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=vera_local
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=vera-private
# Production requires real DB/MinIO/SMTP secrets, HTTPS origins and secure cookies.
