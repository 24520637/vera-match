# LOCAL DEVELOPMENT ONLY. Never commit real credentials.
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
DATABASE_URL=postgresql://vera_dev:vera_dev_change_me@localhost:5432/vera_match?schema=public
POSTGRES_USER=vera_dev
POSTGRES_PASSWORD=vera_dev_change_me
